{
  "name": "recuse",
  "version": "0.6.1",
  "description": "Read the record behind a Polymarket resolution: how many dispute rounds, who was wiped out, and who bought the side that won.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "recuse": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzycd/recuse.git"
  },
  "homepage": "https://github.com/xzycd/recuse#readme",
  "bugs": {
    "url": "https://github.com/xzycd/recuse/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node tools/housekeeping.mjs",
    "site": "node tools/site.mjs",
    "prepare": "node tools/prepare.mjs"
  },
  "dependencies": {
    "ink": "^6.0.1",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "polymarket",
    "prediction-markets",
    "uma",
    "oracle",
    "cli",
    "tui"
  ]
}
